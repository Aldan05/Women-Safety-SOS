<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AssistantSettingsInitial">



    <!-- Toolbar for the ActionBar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorPrimary"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <!-- Hamburger icon placed on the left side of the Toolbar -->
        <ImageButton
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="start"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/back"

            android:onClick="BackFromAssistantSettingsInitial" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ASSISTANT SETTINGS"
            android:textSize="25dp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"/>
    </androidx.appcompat.widget.Toolbar>




    <Button
        android:layout_width="100dp"
        android:layout_height="50dp"
        android:background="@color/button_colour"
        android:layout_marginTop="50dp"
        android:text="Test"
        android:textColor="@color/white"
        android:onClick="MoveToTestWakeWord"/>




</LinearLayout>