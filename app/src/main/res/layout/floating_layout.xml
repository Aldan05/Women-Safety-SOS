<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2A2A2A"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvSosTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 SOS EMERGENCY ACTIVE 🚨"
        android:textColor="#FF5252"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="40dp"/>

    <TextView
        android:id="@+id/timerText"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:background="@drawable/red_circle"
        android:text="10"
        android:textSize="36sp"
        android:layout_centerHorizontal="true"
        android:layout_below="@id/tvSosTitle"
        android:layout_marginTop="20dp"
        android:textColor="@color/white"
        android:gravity="center"/>

    <TextView
        android:id="@+id/tvLocationStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/timerText"
        android:layout_marginTop="20dp"
        android:text="📍 Fetching High-Accuracy Live GPS Location..."
        android:textColor="@color/white"
        android:textSize="15sp"
        android:gravity="center"/>

    <Button
        android:id="@+id/btnViewMap"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvLocationStatus"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:text="🗺️ View Live Location on Map"
        android:textColor="@color/white"
        android:background="@drawable/button_backround"
        android:padding="10dp"
        android:visibility="gone"/>

    <!-- Dismiss Button -->
    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_centerHorizontal="true"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp"
        android:background="@drawable/white_circle"
        android:text="X"
        android:textColor="@color/black"
        android:textSize="28sp"
        android:textStyle="bold"/>
</RelativeLayout>
