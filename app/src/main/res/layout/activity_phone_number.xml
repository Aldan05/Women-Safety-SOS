<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DCDCDC"
    tools:context=".PhoneNumberActivity">

    <!-- Toolbar for the ActionBar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorPrimary"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <!-- Hamburger icon placed on the left side of the Toolbar -->
        <ImageButton
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="start"
            android:background="@color/red"
            android:src="@drawable/back"
            android:onClick="BackFromPhoneNumber" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Authentication"
            android:textSize="20dp"
            android:textColor="@color/white"
            android:layout_gravity="center_horizontal"/>
    </androidx.appcompat.widget.Toolbar>

    <Button
        android:id="@+id/button4"
        android:layout_width="175dp"
        android:layout_height="wrap_content"
        android:background="@drawable/button_backround"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="360dp"
        android:textColor="@color/white"
        android:text="Send OTP"
        android:onClick="ToVerifyPage" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        android:src="@drawable/sos_assistant_logo"
        />


<FrameLayout
    android:layout_width="wrap_content"
    android:layout_height="50dp"

    android:layout_marginTop="200dp">



    <Spinner
        android:id="@+id/spinner_country"
        android:layout_width="85dp"
        android:layout_height="50dp"
        android:layout_marginLeft="10dp"
        android:gravity="start"
        android:background="@drawable/edit_text_border"
        android:drawableEnd="@drawable/down"/>

    <TextView
        android:layout_width="20dp"
        android:layout_height="wrap_content"

        android:text="▼"
        android:layout_marginRight="4dp"
        android:layout_gravity="right"

        android:layout_marginTop="11dp"
        android:textSize="18dp"
        android:textColor="#262626"
        />

</FrameLayout>


    <EditText
        android:id="@+id/editTextPhoneNumber"
        android:layout_width="250dp"
        android:layout_height="50dp"
        android:inputType="number"
        android:hint="Mobile number"
        android:textColorHint="#8E8D8D"



        android:layout_marginLeft="100dp"


        android:layout_marginTop="200dp"
        android:background="@drawable/edit_text_border"
        android:padding="10dp"/>

</RelativeLayout>






